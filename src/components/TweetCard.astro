---
// Pure presentation of an Embed from its Archive. No content-layer access, so
// it can be rendered in isolation; Tweet.astro does the lookup.
//
// Styled after X's own embedded post card, but rendered entirely from the
// Archive: no script, iframe or image request goes to X.
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	archive: CollectionEntry<'embeds'>['data'];
}

const { url, authorName, authorHandle, date, text, capturedAt, removedAt, avatar } = Astro.props.archive;
const profileUrl = `https://x.com/${authorHandle}`;
---

<figure class="tweet">
	<header>
		<a class="author" href={profileUrl}>
			{
				avatar ? (
					<img class="avatar" src={avatar} alt="" width="48" height="48" />
				) : (
					<span class="avatar monogram" aria-hidden="true">
						{/* Whole code point, so a name starting with an emoji is not cut in half. */}
						{[...authorName][0]?.toUpperCase()}
					</span>
				)
			}
			<span class="names">
				<span class="name">{authorName}</span>
				<span class="handle">@{authorHandle}</span>
			</span>
		</a>
		<a class="logo" href={url} aria-label="View on X">
			<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
				<path
					fill="currentColor"
					d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
				></path>
			</svg>
		</a>
	</header>
	<blockquote cite={url}>
		<p>{text}</p>
	</blockquote>
	<figcaption>
		<a href={url}><FormattedDate date={date} month="short" /></a>
	</figcaption>
	{
		removedAt && (
			<p class="removed">
				Removed from X as of <FormattedDate date={removedAt} />; archived <FormattedDate date={capturedAt} />.
			</p>
		)
	}
</figure>

<style>
	/* X's own palette, so the card reads as a social post rather than page chrome. */
	.tweet {
		--x-text: light-dark(#0f1419, #e7e9ea);
		--x-muted: light-dark(#536471, #71767b);
		--x-border: light-dark(#cfd9de, #2f3336);
		--x-bg: light-dark(#ffffff, #000000);
		--x-blue: #1d9bf0;

		max-width: 550px;
		margin-inline: 0;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--x-border);
		border-radius: 12px;
		background-color: var(--x-bg);
		color: var(--x-text);
		font-family:
			-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
		line-height: 1.3125;
	}

	.tweet a {
		color: inherit;
		text-decoration: none;
	}

	header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.author {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
	}

	.avatar {
		flex: none;
		width: 48px;
		height: 48px;
		border-radius: 50%;
	}

	.monogram {
		display: grid;
		place-items: center;
		background-color: var(--x-blue);
		color: #ffffff;
		font-size: 1.25rem;
		font-weight: 700;
	}

	.names {
		display: flex;
		flex-direction: column;
		min-width: 0;
		font-size: 0.9375rem;
	}

	.name,
	.handle {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.name {
		font-weight: 700;
	}

	.author:hover .name {
		text-decoration: underline;
	}

	.handle {
		color: var(--x-muted);
	}

	.logo {
		flex: none;
		display: flex;
	}

	blockquote {
		margin: 0.75rem 0 0;
		padding: 0;
		border: none;
		color: inherit;
	}

	blockquote p {
		margin: 0;
		font-size: 1.25rem;
		line-height: 1.5rem;
		white-space: pre-line;
		overflow-wrap: anywhere;
	}

	figcaption {
		margin-block-start: 0.75rem;
		color: var(--x-muted);
		font-size: 0.9375rem;
	}

	figcaption a:hover {
		text-decoration: underline;
	}

	.removed {
		margin-block: 0.75rem 0;
		padding-block-start: 0.75rem;
		border-block-start: 1px solid var(--x-border);
		color: var(--x-muted);
		font-size: var(--text-sm);
		font-style: italic;
	}
</style>

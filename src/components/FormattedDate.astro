---
interface Props {
	date: Date;
	/** `long` is "March 21, 2006"; `short` is "Mar 21, 2006", as X shows it. */
	month?: 'long' | 'short';
}

const { date, month = 'long' } = Astro.props;
---

<time datetime={date.toISOString().slice(0, 10)}>
	{
		// UTC, because frontmatter dates parse as UTC midnight; formatting in the
		// build machine's zone would show the previous day west of Greenwich.
		date.toLocaleDateString('en-US', {
			year: 'numeric',
			month,
			day: 'numeric',
			timeZone: 'UTC',
		})
	}
</time>

---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString().slice(0, 10)}>
	{
		// UTC, because frontmatter dates parse as UTC midnight; formatting in the
		// build machine's zone would show the previous day west of Greenwich.
		date.toLocaleDateString('en-US', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
			timeZone: 'UTC',
		})
	}
</time>
